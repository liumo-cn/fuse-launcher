<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Fuse.App</RootNamespace>
    <AssemblyName>Fuse Launcher</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.2.6</Version>
    <Product>Fuse Launcher</Product>
    <Company>liumo</Company>
    <AssemblyTitle>Fuse Launcher</AssemblyTitle>
    <Description>Fuse Launcher —— 轻量的 Minecraft 启动器（作者 liumo）</Description>
    <ApplicationIcon>Assets\fuse.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- 不生成 PDB:Release 二进制里连 CodeView 的构建路径(RSDS)都不留,避免泄露本机目录 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\Generated\CfKey.g.cs')">
    <DefineConstants>$(DefineConstants);FUSE_CF_KEY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fuse.Core\Fuse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\bolt.png" />
    <Resource Include="Assets\fuse.ico" />
  </ItemGroup>

</Project>

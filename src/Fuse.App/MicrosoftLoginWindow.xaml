<Window x:Class="Fuse.App.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microsoft 正版登录" Height="440" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#1E2026">
  <Border CornerRadius="14" Margin="18" Padding="26,22"
          BorderThickness="1" BorderBrush="#0FFFFFFF"
          Background="{DynamicResource PanelBgBrush}">
    <StackPanel>
      <TextBlock Text="使用 Microsoft 账号登录" FontSize="17" FontWeight="Bold"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock Text="完成以下两步后本窗口会自动继续：" FontSize="12" Margin="0,12,0,10"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>

      <Border CornerRadius="10" Padding="16,14" Background="#14FFFFFF">
        <StackPanel>
          <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
            <Run Text="1. 打开浏览器访问 "/><Run x:Name="UriText" FontWeight="SemiBold"/>
          </TextBlock>
          <TextBlock FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}">
            <Run Text="2. 输入下面的代码"/>
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="16,8,0,2">
            <TextBlock x:Name="CodeText" Text="----------" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentTextBrush}"/>
            <Button Content="复制代码" Style="{StaticResource ChipButton}" Margin="16,0,0,0"
                    VerticalAlignment="Center" Click="CopyCode_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock x:Name="StatusText" Text="正在申请设备码…" FontSize="12"
                 Margin="0,16,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>

      <Button Content="取消登录" Style="{StaticResource ChipButton}" HorizontalAlignment="Center"
              Margin="0,20,0,0" Padding="20,7,20,7" Click="Cancel_Click"/>
    </StackPanel>
  </Border>
</Window>

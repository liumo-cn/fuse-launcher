<Application x:Class="Fuse.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Fuse.App"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>

    <!-- ============ 玻璃风设计令牌(设计稿 v1.0) ============ -->
    <Color x:Key="GreenColor">#A416E5</Color>
    <SolidColorBrush x:Key="GreenBrush" Color="#A416E5"/>
    <SolidColorBrush x:Key="GreenGlowBrush" Color="#44A416E5"/>
    <SolidColorBrush x:Key="DesktopBrush" Color="#1F2023"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A6FFFFFF"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#6BFFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E05252"/>

    <!-- ============ 通用样式 ============ -->
    <!-- 玻璃行/列表行:R=12 行高44 -->
    <Style x:Key="GlassRow" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource RowBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                    BorderBrush="#0FFFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverSolidBrush}"/>
                <Setter TargetName="bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Color="{DynamicResource HoverColor}" ShadowDepth="0" Opacity="0.55"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 大绿按钮(登录主钮):高60 R=12 绿晕 -->
    <Style x:Key="GreenBigButton" TargetType="Button" BasedOn="{StaticResource GlassRow}">
      <Setter Property="Height" Value="60"/>
      <Setter Property="Background" Value="{DynamicResource GreenBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverSolidBrush}"/>
                <Setter TargetName="bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="24" Color="{DynamicResource HoverColor}" ShadowDepth="0" Opacity="0.7"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 玻璃次按钮 -->
    <Style x:Key="GlassSecondaryButton" TargetType="Button" BasedOn="{StaticResource GreenBigButton}">
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                    BorderBrush="#38FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverSolidBrush}"/>
                <Setter TargetName="bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="24" Color="{DynamicResource HoverColor}" ShadowDepth="0" Opacity="0.7"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 小胶囊按钮(修改/安装/更换) -->
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="#24FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverSolidBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 版本行:悬停高亮由代码控制(鼠标停在行尾 ▶ 上时行内不该变亮),模板里不能自带 IsMouseOver 触发器 -->
    <Style x:Key="VersionRowButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource RowBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12"
                    BorderBrush="#0FFFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 详情页选项行/分类卡片:圆角 + 微软绿高亮(不用系统悬停色) -->
    <Style x:Key="OptRowButton" TargetType="Button">
      <Setter Property="Background" Value="#0FFFFFFF"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                    BorderBrush="#0FFFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverSolidBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverPressedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 胶囊按钮(色环等紧凑场景):圆滑两端 + 轻量高度 -->
    <Style x:Key="PillPrimary" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource GreenBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="24,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="19"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverSolidBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PillSecondary" TargetType="Button" BasedOn="{StaticResource PillPrimary}">
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="19"
                    BorderBrush="#38FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverSolidBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 无边框可点行(手风琴表头等):外观由外层卡片决定,自身只负责点击与 hover 反馈 -->
    <Style x:Key="FlatRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverSolidBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 文件夹列表行:和 FlatRowButton 同款,但 hover 用淡色。
         FlatRowButton 的 HoverSolidBrush 是 72% 实心强调色,整行铺满会盖过"当前"选中态 -->
    <Style x:Key="FolderRowButton" TargetType="Button" BasedOn="{StaticResource FlatRowButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverSoftBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 文件夹列表右键菜单:暗色圆角(默认主题是浅色的,在面板上很突兀) -->
    <Style x:Key="FolderContextMenu" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" CornerRadius="12"
                    Padding="{TemplateBinding Padding}" BorderBrush="#26FFFFFF" BorderThickness="1">
              <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45"/>
              </Border.Effect>
              <StackPanel IsItemsHost="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FolderMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverSolidBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 玻璃列表行(Border 版,供代码构建的行使用):静态卡片,自身不带悬停;
         可点的行请在代码里挂 MouseEnter/Leave(见 DownloadPanel.RetryRow) -->
    <Style x:Key="GlassRowBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource RowBgBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#0FFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,0"/>
    </Style>

    <!-- 面板标题条 -->
    <Style x:Key="PanelTitle" TargetType="Border">
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,11"/>
    </Style>

    <!-- 设置行 -->
    <Style x:Key="OptRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource RowBgBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- 输入框(暗色) -->
    <!-- 输入框(暗色,圆角同卡片) -->
    <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource RowBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="BorderBrush" Value="#24FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkInput" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource RowBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="BorderBrush" Value="#24FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HoverPressedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Toggle 开关(48x28) -->
    <Style x:Key="GlassToggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Border x:Name="track" Width="48" Height="28" CornerRadius="14"
                      Background="#29FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"/>
              <Ellipse x:Name="thumb" Width="22" Height="22" Fill="White"
                       HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource GreenBrush}"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 绿色滑块 -->
    <Style x:Key="GreenSlider" TargetType="Slider">
      <Setter Property="Height" Value="18"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="6" CornerRadius="3" Background="#24FFFFFF"/>
              <Border x:Name="fill" Height="6" CornerRadius="3" HorizontalAlignment="Left"
                      Background="{DynamicResource GreenBrush}"/>
              <Track x:Name="PART_Track">
                <Track.Thumb>
                  <Thumb Width="18" Height="18">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" Stroke="{DynamicResource AccentSoftBrush}" StrokeThickness="4"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 极简滚动条(FR-12):无箭头 / 5px / 轨道透明 / 滑块半透明白,Hover 增亮。隐式样式兜底覆盖全部滚动条 -->
    <Style TargetType="ScrollBar">
      <!-- 静止 1 秒后自动淡出,滚动时再出现(见 ScrollFade) -->
      <Setter Property="app:ScrollFade.AutoHide" Value="True"/>
      <Setter Property="Width" Value="5"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBg" CornerRadius="2.5" Background="#33FFFFFF"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBg" Property="Background" Value="#73FFFFFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModernVScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"/>

<Style x:Key="ModernScrollViewer" TargetType="ScrollViewer">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid>
              <ScrollContentPresenter Margin="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding CanContentScroll}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                         Style="{StaticResource ModernVScrollBar}"
                         HorizontalAlignment="Right" Margin="0,2,1,2"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 玻璃进度条 -->
    <Style x:Key="GlassProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="5"/>
      <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
      <Setter Property="Background" Value="#24FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- 悬浮组件:花瓣小圆(56px 玻璃) -->
    <DropShadowEffect x:Key="OrbGlow" BlurRadius="120" Color="#A416E5" ShadowDepth="0" Opacity="0.9"/>
    <DropShadowEffect x:Key="PetalGlow" BlurRadius="56" Color="#A416E5" ShadowDepth="0" Opacity="0.6"/>
    <SolidColorBrush x:Key="PetalFillBrush" Color="#33A416E5"/>
    <SolidColorBrush x:Key="PetalGlowDiscBrush" Color="#55A416E5"/>
    <SolidColorBrush x:Key="PetalBorderBrush" Color="#8CA416E5"/>
    <DropShadowEffect x:Key="OrbDarkShadow" BlurRadius="32" Color="Black" ShadowDepth="10" Opacity="0.45"/>
    <DropShadowEffect x:Key="PetalShadow" BlurRadius="32" Color="Black" ShadowDepth="8" Opacity="0.45"/>

    <Style x:Key="PetalButton" TargetType="Button">
      <Setter Property="Width" Value="74"/>
      <Setter Property="Height" Value="74"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- 悬浮放大层:以自身中心为基准(56px 的一半),代码里把 ScaleX/Y 动画到 1.25 -->
            <Grid x:Name="petalRoot" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="petalHoverScale" ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <!-- 光晕盘:经 PetalGlow 形成柔和外发光,垫在玻璃盘后 -->
              <Ellipse Fill="{DynamicResource PetalGlowDiscBrush}" Effect="{DynamicResource PetalGlow}"/>
              <!-- 玻璃盘:边缘羽化的主题色圆 -->
              <Ellipse x:Name="bd" Fill="{DynamicResource PetalFillSoftBrush}"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- 悬浮:只换渐变换亮(不加任何描边),和常态一样是柔和过渡 -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Fill" Value="{DynamicResource PetalHoverFillBrush}"/>
                <Setter TargetName="bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="24" Color="{DynamicResource HoverColor}" ShadowDepth="0" Opacity="0.6"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
